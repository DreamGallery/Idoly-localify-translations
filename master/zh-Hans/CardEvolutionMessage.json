{
  "bk1:[[\"cardId\",\"card-hrk-05-link-00\"],[\"evolutionLevel\",0],[\"number\",1]]": {
    "evolveMessage": "我相信，\n能和麻奈站在同一个舞台上的日子一定会到来"
  },
  "bk1:[[\"cardId\",\"card-hrk-05-link-00\"],[\"evolutionLevel\",0],[\"number\",2]]": {
    "evolveMessage": "遥子下次流泪的时候，\n一定是喜悦的开心泪水哦"
  },
  "bk1:[[\"cardId\",\"card-hrk-05-link-00\"],[\"evolutionLevel\",1],[\"number\",1]]": {
    "evolveMessage": "终于能站在同一个舞台上了"
  },
  "bk1:[[\"cardId\",\"card-hrk-05-link-00\"],[\"evolutionLevel\",1],[\"number\",2]]": {
    "evolveMessage": "我一直在等待这一天的到来"
  },
  "bk1:[[\"cardId\",\"card-kan-05-link-00\"],[\"evolutionLevel\",0],[\"number\",1]]": {
    "evolveMessage": "那么～在这张傻脸上\n画点什么好呢"
  },
  "bk1:[[\"cardId\",\"card-kan-05-link-00\"],[\"evolutionLevel\",0],[\"number\",2]]": {
    "evolveMessage": "在脸上涂鸦也太犯规了吧！？"
  },
  "bk1:[[\"cardId\",\"card-kan-05-link-00\"],[\"evolutionLevel\",1],[\"number\",1]]": {
    "evolveMessage": "能做到吧～？"
  },
  "bk1:[[\"cardId\",\"card-kan-05-link-00\"],[\"evolutionLevel\",1],[\"number\",2]]": {
    "evolveMessage": "当然！"
  },
  "bk1:[[\"cardId\",\"card-kkr-05-link-00\"],[\"evolutionLevel\",0],[\"number\",1]]": {
    "evolveMessage": "请将两人绽放的身姿，\n深深印在眼中哦！"
  },
  "bk1:[[\"cardId\",\"card-kkr-05-link-00\"],[\"evolutionLevel\",0],[\"number\",2]]": {
    "evolveMessage": "我会让这个夏天，\n成为最热烈的\n舞台给你看！"
  },
  "bk1:[[\"cardId\",\"card-kkr-05-link-00\"],[\"evolutionLevel\",1],[\"number\",1]]": {
    "evolveMessage": "合宿的成果！"
  },
  "bk1:[[\"cardId\",\"card-kkr-05-link-00\"],[\"evolutionLevel\",1],[\"number\",2]]": {
    "evolveMessage": "让大家看看吧！"
  },
  "bk1:[[\"cardId\",\"card-mna-05-link-00\"],[\"evolutionLevel\",0],[\"number\",1]]": {
    "evolveMessage": "琴乃，是我引以为傲的妹妹哦"
  },
  "bk1:[[\"cardId\",\"card-mna-05-link-00\"],[\"evolutionLevel\",0],[\"number\",2]]": {
    "evolveMessage": "……唔，姐姐……"
  },
  "bk1:[[\"cardId\",\"card-mna-05-link-00\"],[\"evolutionLevel\",1],[\"number\",1]]": {
    "evolveMessage": "走吧，琴乃！"
  },
  "bk1:[[\"cardId\",\"card-mna-05-link-00\"],[\"evolutionLevel\",1],[\"number\",2]]": {
    "evolveMessage": "等等我，姐姐！"
  },
  "bk1:[[\"cardId\",\"card-ngs-05-link-00\"],[\"evolutionLevel\",0],[\"number\",1]]": {
    "evolveMessage": "怎么了？　靠在我身上"
  },
  "bk1:[[\"cardId\",\"card-ngs-05-link-00\"],[\"evolutionLevel\",0],[\"number\",2]]": {
    "evolveMessage": "我，很爱撒娇的……"
  },
  "bk1:[[\"cardId\",\"card-ngs-05-link-00\"],[\"evolutionLevel\",1],[\"number\",1]]": {
    "evolveMessage": "最喜欢你了，琴乃。"
  },
  "bk1:[[\"cardId\",\"card-ngs-05-link-00\"],[\"evolutionLevel\",1],[\"number\",2]]": {
    "evolveMessage": "嗯，我也最喜欢你"
  },
  "bk1:[[\"cardId\",\"card-ski-05-link-00\"],[\"evolutionLevel\",0],[\"number\",1]]": {
    "evolveMessage": "千纱，有没有哪里痒？"
  },
  "bk1:[[\"cardId\",\"card-ski-05-link-00\"],[\"evolutionLevel\",0],[\"number\",2]]": {
    "evolveMessage": "嗯，下次换我帮你洗哦？"
  },
  "bk1:[[\"cardId\",\"card-ski-05-link-00\"],[\"evolutionLevel\",1],[\"number\",1]]": {
    "evolveMessage": "我要上了哦，千纱"
  },
  "bk1:[[\"cardId\",\"card-ski-05-link-00\"],[\"evolutionLevel\",1],[\"number\",2]]": {
    "evolveMessage": "一起加油吧，姐姐！"
  },
  "bk1:[[\"cardId\",\"card-suz-05-link-00\"],[\"evolutionLevel\",0],[\"number\",1]]": {
    "evolveMessage": "为、为什么芽衣的车\n开得那么快啊！？"
  },
  "bk1:[[\"cardId\",\"card-suz-05-link-00\"],[\"evolutionLevel\",0],[\"number\",2]]": {
    "evolveMessage": "啊哈哈，这次轮到\n铃喵\n来追了呢～"
  },
  "bk1:[[\"cardId\",\"card-suz-05-link-00\"],[\"evolutionLevel\",1],[\"number\",1]]": {
    "evolveMessage": "这就是汪喵双子的！"
  },
  "bk1:[[\"cardId\",\"card-suz-05-link-00\"],[\"evolutionLevel\",1],[\"number\",2]]": {
    "evolveMessage": "令人心动的魅力哦～！"
  },
  "bk1:[[\"cardId\",\"card-szk-05-link-00\"],[\"evolutionLevel\",0],[\"number\",1]]": {
    "evolveMessage": "我的青春里，\n身边一直都有\n千纱在"
  },
  "bk1:[[\"cardId\",\"card-szk-05-link-00\"],[\"evolutionLevel\",0],[\"number\",2]]": {
    "evolveMessage": "我能鼓起勇气，\n都是多亏了雫"
  },
  "bk1:[[\"cardId\",\"card-szk-05-link-00\"],[\"evolutionLevel\",1],[\"number\",1]]": {
    "evolveMessage": "我们的关系是——"
  },
  "bk1:[[\"cardId\",\"card-szk-05-link-00\"],[\"evolutionLevel\",1],[\"number\",2]]": {
    "evolveMessage": "——当然是，挚友哦！"
  },
  "bk1:[[\"cardId\",\"card-yu-05-link-00\"],[\"evolutionLevel\",0],[\"number\",1]]": {
    "evolveMessage": "我果然还是\n最喜欢瑠依酱了"
  },
  "bk1:[[\"cardId\",\"card-yu-05-link-00\"],[\"evolutionLevel\",0],[\"number\",2]]": {
    "evolveMessage": "我变得更加喜欢你了"
  },
  "bk1:[[\"cardId\",\"card-yu-05-link-00\"],[\"evolutionLevel\",1],[\"number\",1]]": {
    "evolveMessage": "今后也要一直在一起"
  },
  "bk1:[[\"cardId\",\"card-yu-05-link-00\"],[\"evolutionLevel\",1],[\"number\",2]]": {
    "evolveMessage": "嗯，我们一起走吧，优"
  }
}
